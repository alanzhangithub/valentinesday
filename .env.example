# resend api key - get one at https://resend.com
RESEND_API_KEY=re_xxxxxxxxxx

# email sender address (must be verified in resend)
EMAIL_FROM=Meedobeedo <noreply@yourdomain.com>

# admin email - where wish notifications and stuff go
ADMIN_EMAIL=admin@yourdomain.com

# app url - for links in emails
NEXT_PUBLIC_APP_URL=https://meedobeedo.com
